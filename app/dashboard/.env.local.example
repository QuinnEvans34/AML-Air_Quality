# Copy to .env.local and adjust if you need to override defaults.
# .env.local is git-ignored.

# URL of the FastAPI serving layer. Default assumes uvicorn is running
# on the same host.
FASTAPI_URL=http://localhost:8000

# Path to the pipeline's raw data directory. The dashboard reads
# pm25_*.csv files from this directory to build the "recent hourly
# pattern" lookup for feature prep (Decision 8). Relative paths are
# resolved from the dashboard's working directory (app/dashboard).
RAW_DATA_DIR=../../include/data/raw
