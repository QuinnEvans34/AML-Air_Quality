# Copy this file to .env and fill in the real values. Never commit .env.
# This template is committed; .env is gitignored.

# OpenAQ API v3 — register a free key at https://explore.openaq.org/register
# Then grab it from https://explore.openaq.org/account
OPENAQ_API_KEY=replace-me

# MLflow tracking URI — port 5001 because macOS reserves 5000 for AirPlay
# and Airflow already uses 8080. Start MLflow with: mlflow ui --port 5001
# Inside the Astro container, use http://host.docker.internal:5001 instead of
# localhost. Leave unset to use the in-project file-store default
# (file:///usr/local/airflow/include/mlruns) — this is the simplest setup and
# does not require an MLflow server to be running.
MLFLOW_TRACKING_URI=http://host.docker.internal:5001
