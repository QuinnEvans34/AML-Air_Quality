# Copy this file to .env and fill in the real values. Never commit .env.
# This template is committed; .env is gitignored.

# OpenAQ API v3 — register a free key at https://explore.openaq.org/register
# Then grab it from https://explore.openaq.org/account
OPENAQ_API_KEY=replace-me

# MLflow tracking URI — port 5001 because macOS reserves 5000 for AirPlay
# and Airflow already uses 8080. Start MLflow with: mlflow ui --port 5001
MLFLOW_TRACKING_URI=http://localhost:5001
